<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5e_gripper_moveit_config</name>
  <version>0.0.0</version>
  <description>MoveIt 2 configuration and bringup launch files for the UR5e with a simple parallel gripper</description>
  <maintainer email="ygraspergerpro@gmail.com">Yoann Grasperger</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>ur5e_gripper_description</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
