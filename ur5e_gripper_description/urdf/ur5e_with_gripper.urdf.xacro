<?xml version="1.0"?>
<robot name="$(arg name)" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Le UR5e d'origine (déclare aussi ses arguments : ur_type, tf_prefix...) -->
  <xacro:include filename="$(find ur_robot_driver)/urdf/ur.urdf.xacro"/>

  <!-- Notre gripper -->
  <xacro:include filename="$(find ur5e_gripper_description)/urdf/simple_gripper.xacro"/>

  <!-- Fixé sur le lien tool0 du robot -->
  <xacro:simple_gripper prefix="gripper_" parent="$(arg tf_prefix)tool0"/>

</robot>